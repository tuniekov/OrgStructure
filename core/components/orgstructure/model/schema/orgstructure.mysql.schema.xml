<?xml version="1.0" encoding="UTF-8"?>
<model package="orgstructure" baseClass="xPDOObject" platform="mysql" defaultEngine="InnoDB" phporgstructure-package="orgstructure"
       version="1.1">
    <object class="osTree" table="orgstructure_tree" extends="xPDOSimpleObject">
       <field key="parent_id" dbtype="int" precision="10" attributes="unsigned" phptype="integer" null="true" default="0"/>
       <field key="parents_ids" dbtype="varchar" precision="191" phptype="string" null="false" default=""/>
       <field key="title" dbtype="varchar" precision="191" phptype="string" null="false" default=""/>
       <field key="class" dbtype="varchar" precision="191" phptype="string" null="false" default=""/>
       <field key="target_id" dbtype="int" precision="10" attributes="unsigned" phptype="integer" null="true" default="0"/>
       <field key="menuindex" dbtype="int" precision="10" attributes="unsigned" phptype="integer" null="true" default="0"/>
       <field key="active" dbtype="tinyint" precision="1" phptype="boolean" null="true" default="1"/>

       <index alias="parent_id" name="parent_id" primary="false" unique="false" type="BTREE">
              <column key="parent_id" length="" collation="A" null="false"/>
       </index>
       <index alias="parents_ids" name="parents_ids" primary="false" unique="false" type="BTREE">
              <column key="parents_ids" length="" collation="A" null="false"/>
       </index>
       <index alias="title" name="title" primary="false" unique="false" type="BTREE">
              <column key="title" length="" collation="A" null="false"/>
       </index>
       <index alias="class" name="class" primary="false" unique="false" type="BTREE">
              <column key="class" length="" collation="A" null="false"/>
       </index>
       <index alias="target_id" name="target_id" primary="false" unique="false" type="BTREE">
              <column key="target_id" length="" collation="A" null="false"/>
       </index>
       <index alias="active" name="active" primary="false" unique="false" type="BTREE">
              <column key="active" length="" collation="A" null="false"/>
       </index>
    </object>

    <object class="osOrg" table="orgstructure_orgs" extends="xPDOSimpleObject">
       <field key="name" dbtype="varchar" precision="191" phptype="string" null="false" default=""/>
       <field key="active" dbtype="tinyint" precision="1" phptype="boolean" null="true" default="1"/>

       <index alias="active" name="active" primary="false" unique="false" type="BTREE">
              <column key="active" length="" collation="A" null="false"/>
       </index>
       <index alias="name" name="name" primary="false" unique="false" type="BTREE">
              <column key="name" length="" collation="A" null="false"/>
       </index>
    </object>

    <object class="osFilial" table="orgstructure_filials" extends="xPDOSimpleObject">
       <field key="name" dbtype="varchar" precision="191" phptype="string" null="false" default=""/>
       <field key="active" dbtype="tinyint" precision="1" phptype="boolean" null="true" default="0"/>
       <field key="default" dbtype="tinyint" precision="1" phptype="boolean" null="true" default="0"/>

       <index alias="active" name="active" primary="false" unique="false" type="BTREE">
              <column key="active" length="" collation="A" null="false"/>
       </index>
       <index alias="default" name="default" primary="false" unique="false" type="BTREE">
              <column key="default" length="" collation="A" null="false"/>
       </index>
       <index alias="name" name="name" primary="false" unique="false" type="BTREE">
              <column key="name" length="" collation="A" null="false"/>
       </index>
    </object>
    <object class="osDepartment" table="orgstructure_departments" extends="xPDOSimpleObject">
       <field key="name" dbtype="varchar" precision="191" phptype="string" null="false" default=""/>
       <field key="active" dbtype="tinyint" precision="1" phptype="boolean" null="true" default="0"/>
       <!-- Флаг для обратной синхронизации в legacy gts_departarment_staff_links:
            если 1 — сотрудники этого отдела (и дочерних) попадают в Цех Паша (id=1),
            иначе в Офис (id=2). См. OrgStructure::syncEmployeeToLegacy. -->
       <field key="sync_to_zeh" dbtype="tinyint" precision="1" phptype="boolean" null="true" default="0"/>

       <index alias="active" name="active" primary="false" unique="false" type="BTREE">
              <column key="active" length="" collation="A" null="false"/>
       </index>
       <index alias="name" name="name" primary="false" unique="false" type="BTREE">
              <column key="name" length="" collation="A" null="false"/>
       </index>
       <index alias="sync_to_zeh" name="sync_to_zeh" primary="false" unique="false" type="BTREE">
              <column key="sync_to_zeh" length="" collation="A" null="false"/>
       </index>
    </object>
    <object class="osPost" table="orgstructure_posts" extends="xPDOSimpleObject">
       <field key="name" dbtype="varchar" precision="191" phptype="string" null="false" default=""/>

       <index alias="name" name="name" primary="false" unique="false" type="BTREE">
              <column key="name" length="" collation="A" null="false"/>
       </index>
    </object>
    <object class="osEmployee" table="orgstructure_employees" extends="xPDOSimpleObject">
       <field key="name" dbtype="varchar" precision="191" phptype="string" null="false" default=""/>
       <field key="active" dbtype="tinyint" precision="1" phptype="boolean" null="true" default="0"/>
       <field key="user_id" dbtype="int" precision="10" attributes="unsigned" phptype="integer" null="true" default="0"/>
       <field key="post_id" dbtype="int" precision="10" attributes="unsigned" phptype="integer" null="true" default="0"/>
       <field key="track_schedule" dbtype="tinyint" precision="1" phptype="boolean" null="true" default="0"/>
       <field key="work_time_from" dbtype="time" phptype="string" null="true" default="09:00:00"/>
       <field key="work_time_to" dbtype="time" phptype="string" null="true" default="18:00:00"/>
       <field key="has_lunch" dbtype="tinyint" precision="1" phptype="boolean" null="true" default="1"/>
       <field key="photo" dbtype="varchar" precision="255" phptype="string" null="true"/>

       <!-- Карточка сотрудника по мокапу отдела кадров -->
       <field key="birth_date" dbtype="date" phptype="date" null="true"/>
       <!-- 1 мужской, 2 женский: нормы выдачи СИЗ у мужчин и женщин разные -->
       <field key="sex" dbtype="tinyint" precision="1" attributes="unsigned" phptype="integer" null="true" default="0"/>
       <field key="inn" dbtype="varchar" precision="20" phptype="string" null="true" default=""/>
       <field key="snils" dbtype="varchar" precision="20" phptype="string" null="true" default=""/>
       <field key="hired_at" dbtype="date" phptype="date" null="true"/>
       <!-- График как текст справочных вариантов: смены живут в Smena, здесь только пометка кадров -->
       <field key="schedule" dbtype="varchar" precision="20" phptype="string" null="true" default=""/>
       <field key="phone" dbtype="varchar" precision="50" phptype="string" null="true" default=""/>
       <field key="address" dbtype="varchar" precision="255" phptype="string" null="true" default=""/>

       <!-- Размеры для выдачи спецодежды и печати личной карточки учёта СИЗ.
            Строками: пишут «48-50», «10.5» — числом это не удержать. -->
       <field key="height" dbtype="varchar" precision="20" phptype="string" null="true" default=""/>
       <field key="size_cloth" dbtype="varchar" precision="20" phptype="string" null="true" default=""/>
       <field key="size_shoe" dbtype="varchar" precision="20" phptype="string" null="true" default=""/>

       <index alias="active" name="active" primary="false" unique="false" type="BTREE">
              <column key="active" length="" collation="A" null="false"/>
       </index>
       <index alias="name" name="name" primary="false" unique="false" type="BTREE">
              <column key="name" length="" collation="A" null="false"/>
       </index>
       <index alias="user_id" name="user_id" primary="false" unique="false" type="BTREE">
              <column key="user_id" length="" collation="A" null="false"/>
       </index>
    </object>
    <object class="osAccess" table="orgstructure_accesses" extends="xPDOSimpleObject">
       <field key="tree_id" dbtype="int" precision="10" attributes="unsigned" phptype="integer" null="true" default="0"/>
       <field key="group_id" dbtype="int" precision="10" attributes="unsigned" phptype="integer" null="true" default="0"/>
       <field key="user_id" dbtype="int" precision="10" attributes="unsigned" phptype="integer" null="true" default="0"/>
       <field key="active" dbtype="tinyint" precision="1" phptype="boolean" null="true" default="0"/>

       <index alias="tree_id" name="tree_id" primary="false" unique="false" type="BTREE">
              <column key="tree_id" length="" collation="A" null="false"/>
       </index>
       <index alias="user_id" name="user_id" primary="false" unique="false" type="BTREE">
              <column key="user_id" length="" collation="A" null="false"/>
       </index>
       <index alias="group_id" name="group_id" primary="false" unique="false" type="BTREE">
              <column key="group_id" length="" collation="A" null="false"/>
       </index>
       <index alias="active" name="active" primary="false" unique="false" type="BTREE">
              <column key="active" length="" collation="A" null="false"/>
       </index>
    </object>
    <!-- Документы сотрудника: трудовой договор, допсоглашения, квалификация.
         Одна таблица на три вкладки — набор полей у них общий, а различают их
         подписи и фильтр kind. Три таблицы дали бы три копии одного кода. -->
    <object class="osEmployeeDoc" table="orgstructure_employee_docs" extends="xPDOSimpleObject">
       <field key="employee_id" dbtype="int" precision="10" attributes="unsigned" phptype="integer" null="false" default="0"/>
       <!-- contract | agreement | qualification -->
       <field key="kind" dbtype="varchar" precision="20" phptype="string" null="false" default=""/>
       <field key="name" dbtype="varchar" precision="255" phptype="string" null="false" default=""/>
       <!-- Для квалификации: «Допуск», «Обучение», «Профессиональная квалификация» -->
       <field key="category" dbtype="varchar" precision="100" phptype="string" null="true" default=""/>
       <field key="number" dbtype="varchar" precision="100" phptype="string" null="true" default=""/>
       <!-- Дата документа: подписания у соглашения, выдачи у удостоверения -->
       <field key="date_start" dbtype="date" phptype="date" null="true"/>
       <!-- Вступления в силу у соглашения, «действует до» у удостоверения -->
       <field key="date_end" dbtype="date" phptype="date" null="true"/>
       <field key="file" dbtype="varchar" precision="255" phptype="string" null="true" default=""/>
       <field key="active" dbtype="tinyint" precision="1" phptype="boolean" null="true" default="1"/>
       <field key="comment" dbtype="text" phptype="string" null="true"/>
       <field key="createdon" dbtype="datetime" phptype="datetime" null="true"/>
       <field key="createdby" dbtype="int" precision="10" attributes="unsigned" phptype="integer" null="true" default="0"/>

       <index alias="employee_id" name="employee_id" primary="false" unique="false" type="BTREE">
              <column key="employee_id" length="" collation="A" null="false"/>
       </index>
       <index alias="kind" name="kind" primary="false" unique="false" type="BTREE">
              <column key="kind" length="" collation="A" null="false"/>
       </index>
       <index alias="date_end" name="date_end" primary="false" unique="false" type="BTREE">
              <column key="date_end" length="" collation="A" null="false"/>
       </index>
    </object>
</model>
